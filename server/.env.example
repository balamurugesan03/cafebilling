PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/brewbill
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES=7d
# Timezone used for reports / dashboards grouping
TZ_NAME=Asia/Kolkata
CLIENT_URL=http://localhost:5173
# Sub-path the app is served under in production (https://unizova.com/cafebilling)
# Leave empty if your reverse proxy strips /cafebilling before forwarding
BASE_PATH=
